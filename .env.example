# true uses deterministic local GitHub and Devin adapters and spends no ACUs.
DEMO_MODE=true

# Devin v3 organization service user (one key for sessions, Playbooks, Knowledge).
DEVIN_API_KEY=
DEVIN_ORG_ID=org-xxxxxxxxxxxx

# GitHub fine-grained token: Issues read/write, Pull requests read, Metadata read,
# and Checks read (the CI gate reads check-runs on the pull request head commit).
GITHUB_TOKEN=
GITHUB_REPO=harry1174/superset
GITHUB_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32

TRIGGER_LABEL=devin:autofix
# Superset sessions pay for a heavy install before they do any work. A cap that
# is too tight burns ACUs and produces nothing; concurrency and the daily budget
# are the real controls.
MAX_ACU_PER_TASK=25
MAX_CONCURRENT_SESSIONS=2
DAILY_ACU_BUDGET=60
SESSION_TIMEOUT_MINUTES=45
POLL_INTERVAL_SECONDS=10
SYNC_POLICY_ON_BOOT=true

# Devin's verdict is a claim. With this on, a pull request is only counted as
# verified once the repository's own check-runs agree. Set false only if the
# target repository has no CI; the dashboard then says verification is
# self-reported.
REQUIRE_CI_CHECKS=true
CHECKS_GRACE_MINUTES=15

# Inputs to the "Modeled" panel only. Nothing here touches a measured number.
# Confirm the ACU rate against your own Devin account: it is not a public figure
# and the default below is a placeholder, not a quote.
ACU_UNIT_COST_USD=2.25
# What the same remediation would cost a human end to end, as a low/base/high
# band. A point estimate invites an argument about the point.
BASELINE_HUMAN_HOURS_LOW=1.0
ENGINEER_HOURS_PER_MERGED_PR=2.5
BASELINE_HUMAN_HOURS_HIGH=4.0
ENGINEER_HOURLY_COST_USD=110
DB_PATH=/data/remediation.db
